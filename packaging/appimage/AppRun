#!/bin/sh
# =============================================================================
#  AppRun — Entry point for the Parabolic AppImage
# =============================================================================
#  This script is used as the "wrapped" entry point. When linuxdeploy runs with
#  the gtk plugin, it keeps this file under the name "AppRun.wrapped" and
#  generates a fresh "AppRun" in front of it that sources the linuxdeploy gtk
#  hooks (GDK_PIXBUF_MODULE_FILE, GSETTINGS_SCHEMA_DIR, GTK_PATH, etc.), then
#  execs this file. So the effective startup chain at runtime is:
#
#      AppRun (linuxdeploy)  →  sources apprun-hooks/*.sh
#                            →  exec AppRun.wrapped (THIS FILE)
#                            →  sets more env (LD_LIBRARY_PATH, PATH, ...)
#                            →  exec usr/bin/org.nickvision.tubeconverter
#                            →  exec the .NET binary
#
#  NOTE: do NOT source the linuxdeploy hook from THIS file. The hook is sourced
#  by the linuxdeploy-generated AppRun already; sourcing it again here would
#  re-run dbus-send/gsettings and, on some systems, deadlock at startup.
# =============================================================================
set -e

# AppImageKit sets $APPDIR, $ARGV0, $APPIMAGE when running an AppImage.
# When running from an extracted AppDir (./AppRun), $APPDIR is unset.
if [ -z "${APPDIR:-}" ]; then
    APPDIR="$(dirname "$(readlink -f "$0")")"
fi

# Prepend bundled lib dirs to LD_LIBRARY_PATH so the bundled .so files take
# precedence over the host system's. This is what makes the AppImage portable.
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/usr/lib/org.nickvision.tubeconverter:${APPDIR}/usr/lib/x86_64-linux-gnu:${APPDIR}/usr/lib/aarch64-linux-gnu:${LD_LIBRARY_PATH:-}"

# Make sure bundled binaries (yt-dlp, ffmpeg, aria2c, deno, curl-impersonate*)
# are findable on $PATH — the .NET app's FindDependency() falls back to $PATH.
export PATH="${APPDIR}/usr/bin:${APPDIR}/usr/lib/org.nickvision.tubeconverter:${PATH:-}"

# XDG data dirs — include host's so host themes/icons remain available, but
# prepend our own so our desktop file / metainfo / icons win.
export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# gdk-pixbuf loaders cache — points to the bundled one with relative paths.
export GDK_PIXBUF_MODULE_FILE="${APPDIR}/usr/lib/org.nickvision.tubeconverter/gdk-pixbuf-2.0/2.10.0/loaders.cache"

# GIO modules — make sure gio loads its bundled modules (gvfs, etc.) first.
export GIO_MODULE_DIR="${APPDIR}/usr/lib/x86_64-linux-gnu/gio/modules:${APPDIR}/usr/lib/aarch64-linux-gnu/gio/modules"

# GStreamer — if you bundle GStreamer plugins, set this to point at them.
# (Parabolic doesn't use GStreamer directly, but ffmpeg does for some formats.)
export GST_PLUGIN_SYSTEM_PATH="${APPDIR}/usr/lib/x86_64-linux-gnu/gstreamer-1.0:${APPDIR}/usr/lib/aarch64-linux-gnu/gstreamer-1.0:${GST_PLUGIN_SYSTEM_PATH:-}"

# Force the .NET runtime to use the bundled runtime config (the .NET binary is
# already self-contained, so this is mostly belt-and-suspenders).
export DOTNET_ROOT="${APPDIR}/usr/lib/org.nickvision.tubeconverter"
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=0

# Hand off to the launcher script (which execs the .NET binary).
# The launcher handles both AppImage ($APPDIR set → $APPDIR/usr/lib/...) and
# local install ($APPDIR unset → PREFIX/lib/...) cases.
exec "${APPDIR}/usr/bin/org.nickvision.tubeconverter" "$@"